# For the CLI. Copy to `.env` and fill in.
# Alternatively (and preferred), run `python orders.py init` which writes
# ~/.config/orders/config.json.
#
# If both this file and ~/.config/orders/config.json exist, the config.json
# wins.
ORDERS_API_URL=https://request-email-filter.<your-subdomain>.workers.dev
ORDERS_API_TOKEN=<paste your ADMIN_TOKEN from wrangler secret put>
