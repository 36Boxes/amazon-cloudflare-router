{
  "python.defaultInterpreterPath": "${workspaceFolder}/cli/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": false,
    "**/node_modules": true,
    "**/.wrangler": true
  },
  "editor.rulers": [88, 100],
  "editor.tabSize": 2,
  "[python]": {
    "editor.tabSize": 4
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.rulers": [80]
  }
}
